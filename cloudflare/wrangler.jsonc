{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-monitor",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "geekhaven-monitor",
    "database_id": "45993e27-a9b4-4d09-a79b-a6374c1013a6"
  }]
}
